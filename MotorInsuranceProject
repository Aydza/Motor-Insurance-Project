```{r}
#function to find optimal cp using 1 SE rule
cp.select <- function(tree){
  min.x <- which.min(tree$cp[, 4])
  for(i in 1:nrow(tree$cp)){
    if(tree$cp[i, 4] < tree$cp[min.x, 4] 
       + tree$cp[min.x, 5]){
      return(tree$cp[i, 1])
    }
  }
}

cp.optimal<-cp.select(tree.PoissonCounts)
cp.optimal
```

```{r}
# Prune to optimal tree
