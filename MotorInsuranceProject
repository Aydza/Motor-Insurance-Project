```{r}
set.seed(10)

#Create a temporary dataset with identical features to Motor
Motor2 <- Motor

# Make a shuffled copy of dataset
MotorCV <- Motor2
MotorCV$random <- runif(nrow(MotorCV))
MotorCV <- MotorCV[order(MotorCV$random),]

# Assign fold labels (K = 10)
K <- 10
MotorCV$CV <- rep(1:K, length = nrow(MotorCV))
```

```{r}
#Initialize total CV error
glm.CVerror <- 0

for (k1 in 1:K) {
  
  # Split into training and test folds
  Motor.train <- MotorCV[MotorCV$CV != k1, ]
  Motor.test  <- MotorCV[MotorCV$CV == k1, ]
  
  # Update the model on Training fold only
  glm.fold <-  update(glm.PoissonCounts, data = Motor.train)
  # Predict expected counts for the test fold
  Motor.test$fit <- predict(glm.fold, newdata = Motor.test, type = "response")
  
  # Compute mean squared error 
  glm.CVerror <- glm.CVerror + mean(( Motor.test$fit-Motor.test$Counts)^2)
}

# Average over K folds
glm.CVerror <- glm.CVerror / K
glm.CVerror
```


