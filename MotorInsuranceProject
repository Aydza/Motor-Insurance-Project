```{r}
#create a function returning out-of-sample error
require(gbm)

set.seed(10)

trainsampleindex<-sample(c(1:nrow(Motor)),0.9*nrow(Motor), replace=FALSE)
train<-Motor[trainsampleindex,]
test<-Motor[-trainsampleindex,]
train$fit <- train$exposure
test$fit <- test$exposure

boost.OOSerror <- function(idepth, K, shrinkage){
options(warn = -1) #to avoid printing warnings
  
set.seed(10)
boost.PoissonCounts <- suppressWarnings(gbm(Counts~offset(log(exposure))+
                                        weight+distance+age+carage+gender,
                                    data=train,
                                    distribution="poisson",n.trees=K,
                                    shrinkage=shrinkage,interaction.depth=idepth))

test$predict<-suppressWarnings(test$exposure*predict(boost.PoissonCounts,newdata=test,type="response"))
out_sample_error<-2*(sum(log((test$Counts/test$predict)^test$Counts))-
                              sum(test$Counts)+sum(test$predict))/nrow(test)
out_sample_error
}
```

```{r}
#tune shrinkage and tree size with fixed number of iteration
idepth_grid <- c(1,2,3)
K_grid <- 50
shrinkage_grid <- seq(0.1, 0.9, 0.4)

# Store results
tune_results <- expand.grid(idepth = idepth_grid,
                            K = K_grid,
                            shrinkage = shrinkage_grid)
tune_results$out_sample_error <- NA

# Loop over all combinations
for(i in 1:nrow(tune_results)){
  params <- tune_results[i, ]
  message("Testing idepth =", params$idepth,
      ", K =", params$K,
      ", shrinkage =", params$shrinkage, "\n")
  
  tune_results$out_sample_error[i] <- boost.OOSerror(
    idepth = params$idepth,
    K = params$K,
    shrinkage = params$shrinkage
  )
}

# Find best combination
best_row <- tune_results[which.min(tune_results$out_sample_error), ]
best_row

```

```{r}
#select the best parameter pair
best_idepth <- best_row$idepth
best_shrinkage <- best_row$shrinkage

